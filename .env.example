# Local: SQLite. Netlify: PostgreSQL obligatorio, pooler de transacciones (puerto 6543).
DATABASE_URL=
DATABASE_CA_CERT=
SQLITE_PATH=.local/gc-predictor.sqlite
# Netlify fija GC_REMOTE_ONLY=1. Producción nunca crea SQLite ni importa el banco público.
GC_REMOTE_ONLY=0
# Solo variables del servidor: contraseña de al menos 16 caracteres en Netlify, secreto >=32.
PRIVATE_APP_PASSWORD=
SESSION_SECRET=
# Todos los PDFs y evidencias: bucket PRIVADO sin políticas para anon/authenticated.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gc-originals
# Opcional: importaciones CLI autenticadas. Nunca NEXT_PUBLIC_ ni en el cliente.
IMPORT_API_TOKEN=
