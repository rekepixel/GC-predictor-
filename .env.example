# Vacío: SQLite en .local/gc-predictor.sqlite. PostgreSQL: cadena de conexión Supabase.
DATABASE_URL=
SQLITE_PATH=.local/gc-predictor.sqlite
# Obligatorio en producción. Genera con: openssl rand -base64 32
PRIVATE_APP_PASSWORD=
SESSION_SECRET=
# PDFs: filesystem local por defecto; en Supabase usa un bucket PRIVADO.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gc-originals
# Opcional: importaciones CLI autenticadas. Nunca NEXT_PUBLIC_ ni en el cliente.
IMPORT_API_TOKEN=
